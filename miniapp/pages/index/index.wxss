page { background: #f5f0e8; color: #3d3225; font-size: 28rpx; line-height: 1.6; }
.scroll { height: 100vh; }

/* Hero */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #faf6ef 0%, #f0e8d8 50%, #e8dcc8 100%);
  padding: 120rpx 32rpx; text-align: center;
}
.hero-inner { max-width: 700rpx; margin: 0 auto; }
.hero-badge {
  display: inline-block; padding: 10rpx 30rpx; border-radius: 999rpx;
  font-size: 22rpx; letter-spacing: 4rpx; color: #8b6914;
  border: 1px solid rgba(180,140,60,0.25); background: rgba(180,140,60,0.08);
  margin-bottom: 36rpx;
}
.hero-title {
  font-size: 96rpx; font-weight: 700; color: #8b6914;
  margin-bottom: 24rpx; letter-spacing: -2rpx;
}
.hero-sub { font-size: 34rpx; color: #6b5a3e; margin-bottom: 10rpx; }
.hero-sub2 { font-size: 26rpx; color: #9e8e72; margin-bottom: 48rpx; }
.hero-cta {
  display: inline-block; padding: 22rpx 56rpx; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 600;
  background: linear-gradient(135deg, #b48c0f, #8b6914); color: #fff;
}

/* Stats */
.stats {
  display: flex; flex-wrap: wrap; padding: 40rpx 24rpx; gap: 16rpx;
}
.stat-card {
  flex: 1 1 42%; text-align: center; padding: 28rpx 16rpx;
  border-radius: 20rpx; border: 1px solid rgba(180,140,60,0.15);
  background: linear-gradient(145deg, #fffcf5, #f5efe3);
  box-shadow: 0 4rpx 20rpx rgba(100,80,30,0.04);
}
.stat-num { font-size: 52rpx; font-weight: 700; color: #8b6914; }
.stat-unit { font-size: 22rpx; color: #9e8e72; margin-left: 4rpx; }
.stat-label { font-size: 22rpx; color: #9e8e72; margin-top: 6rpx; }

/* Timeline */
.timeline-section { padding: 80rpx 24rpx; }
.timeline-title {
  font-size: 48rpx; font-weight: 700; color: #8b6914; text-align: center; margin-bottom: 10rpx;
}
.timeline-sub { text-align: center; font-size: 26rpx; color: #9e8e72; margin-bottom: 80rpx; }
.timeline-wrap { position: relative; }
.timeline-line {
  position: absolute; left: 50%; top: 0; bottom: 0;
  width: 4rpx; margin-left: -2rpx;
  background: linear-gradient(to bottom, transparent, #b48c0f 10%, #b48c0f 90%, transparent);
}

/* Dynasty Item */
.dynasty-item {
  position: relative; display: flex; align-items: center;
  margin-bottom: 72rpx;
}
.dynasty-item.left { flex-direction: row; }
.dynasty-item.right { flex-direction: row-reverse; }
.dynasty-dot {
  position: absolute; left: 50%; top: 50%; z-index: 2;
  width: 28rpx; height: 28rpx; border-radius: 50%;
  border: 6rpx solid #f5f0e8; transform: translate(-50%, -50%);
}
.dynasty-card {
  width: 42%; border-radius: 20rpx; overflow: hidden;
  border: 1px solid rgba(180,140,60,0.18);
  background: linear-gradient(145deg, #fffcf5, #f5efe3);
  box-shadow: 0 4rpx 24rpx rgba(100,80,30,0.06);
}
.dynasty-item.left .dynasty-card { margin-right: auto; }
.dynasty-item.right .dynasty-card { margin-left: auto; }

/* Card image */
.dynasty-bar { border-radius: 6rpx 6rpx 0 0; }
.dynasty-img { position: relative; height: 200rpx; overflow: hidden; }
.dynasty-img-src { width: 100%; height: 100%; opacity: 0.5; }
.dynasty-img-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 30%, rgba(245,240,232,0.95) 100%);
}
.dynasty-img-name {
  position: absolute; bottom: 14rpx; left: 24rpx;
  font-size: 36rpx; font-weight: 700;
}

/* Card body */
.dynasty-body { padding: 24rpx 30rpx 30rpx; }
.dynasty-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.dynasty-name { font-size: 36rpx; font-weight: 700; }
.dynasty-period { font-size: 22rpx; color: #9e8e72; }
.dynasty-badge { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.dynasty-desc {
  font-size: 24rpx; color: #6b5a3e; line-height: 1.7; margin-bottom: 20rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 3; -webkit-box-orient: vertical;
}

/* Tags */
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag-chip {
  padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 20rpx;
  border: 1px solid rgba(180,140,60,0.2); background: rgba(180,140,60,0.06);
  color: #8b6914;
}

/* Footer */
.footer { text-align: center; padding: 48rpx 24rpx; font-size: 22rpx; color: #9e8e72; border-top: 1px solid rgba(180,140,60,0.1); }

/* Modal */
.modal-mask {
  position: fixed; inset: 0; z-index: 999;
  background: rgba(0,0,0,0.5); display: flex; align-items: flex-end;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s;
}
.modal-mask.show { opacity: 1; pointer-events: auto; }
.modal-box {
  position: relative; width: 100%; max-height: 85vh;
  background: #faf6ef; border-radius: 36rpx 36rpx 0 0;
  display: flex; flex-direction: column; overflow: hidden;
}
.modal-close {
  position: absolute; top: 24rpx; right: 24rpx; z-index: 10;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0,0,0,0.25); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.modal-scroll { padding: 24rpx 28rpx; flex: 1; }
.modal-img-wrap { position: relative; height: 280rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.modal-img { width: 100%; height: 100%; opacity: 0.55; }
.modal-img-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 40%, rgba(250,246,239,0.95) 100%);
}
.modal-img-title { position: absolute; bottom: 16rpx; left: 24rpx; font-size: 52rpx; font-weight: 700; }
.modal-period { font-size: 26rpx; color: #9e8e72; margin-bottom: 20rpx; }
.modal-years { color: #8b6914; font-weight: 600; }
.modal-desc { font-size: 28rpx; color: #6b5a3e; line-height: 1.8; margin-bottom: 28rpx; }
.modal-section-title {
  font-size: 30rpx; font-weight: 700; color: #8b6914;
  margin: 28rpx 0 16rpx; padding-left: 16rpx;
  border-left: 4rpx solid #b48c0f;
}

/* Events */
.event-item { display: flex; align-items: flex-start; gap: 14rpx; padding: 14rpx 20rpx; border-radius: 12rpx; border: 1px solid rgba(180,140,60,0.12); background: rgba(180,140,60,0.03); margin-bottom: 10rpx; font-size: 26rpx; color: #5a4a30; }
.event-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; margin-top: 10rpx; }

/* Chips */
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.figure-chip, .invention-chip { padding: 10rpx 24rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 500; border: 1px solid rgba(180,140,60,0.2); background: rgba(180,140,60,0.06); color: #8b6914; }

/* Turning Points */
.tp-item { position: relative; padding-left: 30rpx; margin-bottom: 24rpx; }
.tp-item::before { content:''; position: absolute; left: 0; top: 10rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #8b6914; border: 4rpx solid #f5f0e8; }
.tp-year { font-weight: 600; font-size: 26rpx; color: #8b6914; }
.tp-desc { font-size: 24rpx; color: #6b5a3e; margin-top: 4rpx; }
.tp-sig { font-size: 22rpx; color: #9e8e72; margin-top: 4rpx; font-style: italic; }
